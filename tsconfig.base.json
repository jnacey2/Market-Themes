{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@market-themes/db": ["packages/db/src/index.ts"],
      "@market-themes/analysis": ["packages/analysis/src/index.ts"],
      "@market-themes/ingest": ["packages/ingest/src/index.ts"]
    }
  }
}
