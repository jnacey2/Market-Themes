{
  "name": "market-themes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @market-themes/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --import tsx --test --test-concurrency=1 packages/*/src/*.test.ts packages/db/scripts/*.test.mjs apps/web/lib/*.test.ts workers/src/jobs/*.test.ts",
    "worker": "npm run start --workspace @market-themes/workers",
    "pipeline": "npm run pipeline --workspace @market-themes/workers",
    "sec:smoke": "npm run sec:smoke --workspace @market-themes/workers",
    "sec:backfill": "npm run sec:backfill --workspace @market-themes/workers",
    "fmp:smoke": "npm run fmp:smoke --workspace @market-themes/workers",
    "fmp:backfill": "npm run fmp:backfill --workspace @market-themes/workers",
    "fmp:poll": "npm run fmp:poll --workspace @market-themes/workers",
    "claude:extract:smoke": "npm run claude:extract:smoke --workspace @market-themes/workers",
    "claude:extract:backfill": "npm run claude:extract:backfill --workspace @market-themes/workers",
    "claude:extract:batch": "npm run claude:extract:batch --workspace @market-themes/workers",
    "narratives:classify": "npm run narratives:classify --workspace @market-themes/workers",
    "narratives:classify:batch": "npm run narratives:classify:batch --workspace @market-themes/workers",
    "narratives:discover": "npm run narratives:discover --workspace @market-themes/workers",
    "narratives:discover:batch": "npm run narratives:discover:batch --workspace @market-themes/workers",
    "anthropic:batches:poll": "npm run anthropic:batches:poll --workspace @market-themes/workers",
    "eval:narratives": "npm run eval:narratives --workspace @market-themes/workers --",
    "eval:export": "npm run eval:export --workspace @market-themes/workers --",
    "narratives:backtest": "npm run narratives:backtest --workspace @market-themes/workers --",
    "narratives:auto-review": "npm run narratives:auto-review --workspace @market-themes/workers",
    "narrative-trends:recompute": "npm run narrative-trends:recompute --workspace @market-themes/workers",
    "premium:scrape": "npm run premium:scrape --workspace @market-themes/workers",
    "premium:capture-session": "npm run premium:capture-session --workspace @market-themes/workers --",
    "substack:capture-session": "npm run substack:capture-session --workspace @market-themes/workers --",
    "substack:scrape": "npm run substack:scrape --workspace @market-themes/workers --",
    "repair:document-texts": "npm run repair:document-texts --workspace @market-themes/workers",
    "themes:normalize": "npm run themes:normalize --workspace @market-themes/workers",
    "themes:normalize:backfill": "npm run themes:normalize:backfill --workspace @market-themes/workers",
    "db:schema": "node packages/db/scripts/print-schema.mjs",
    "db:apply": "node packages/db/scripts/apply-schema.mjs",
    "db:apply:predeploy": "node packages/db/scripts/apply-schema.mjs --allow-unresolved-host"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
