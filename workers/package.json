    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@market-themes/analysis": "0.1.0",
    "@market-themes/db": "0.1.0",
    "@market-themes/ingest": "0.1.0",
    "tsx": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  }
